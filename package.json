{
  "name": "little-worlds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size:check": "bun scripts/check-bundle-size.mjs",
    "perf:smoke": "bun scripts/run-performance.mjs --runs 1 --output .artifacts/performance/smoke.json && bun scripts/check-performance-budget.mjs --results .artifacts/performance/smoke.json",
    "perf:benchmark": "bun scripts/run-performance.mjs --runs 3 --output .artifacts/performance/results.json",
    "perf:budget": "bun scripts/check-performance-budget.mjs --results .artifacts/performance/results.json",
    "perf:ci": "bun run build && bun run size:check && bun run perf:benchmark && bun run perf:budget",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "perf:engines": "bun scripts/profile-engines.mjs",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vercel/node": "^5.8.27",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
